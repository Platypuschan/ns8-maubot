{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Node.js builder image used by build-images.sh",
      "managerFilePatterns": [
        "/^build-images\\.sh$/"
      ],
      "matchStrings": [
        "NODE_IMAGE=\"docker\\.io/library/node:(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "pillow-heif wheel installed into the maubot runtime image",
      "managerFilePatterns": [
        "/^runtime/Containerfile$/"
      ],
      "matchStrings": [
        "\"pillow-heif==(?<currentValue>[0-9][^\"]*)\""
      ],
      "depNameTemplate": "pillow-heif",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "The maubot runtime base image (tag + digest in runtime/Containerfile) is part of the module image: every update raises CATALOG_VERSION. Patch and digest updates merge automatically once all CI checks (incl. QEMU install/update tests) are green; minor releases (0.x) get a PR for manual review",
      "matchDepNames": [
        "dock.mau.dev/maubot/maubot"
      ],
      "commitMessageTopic": "maubot",
      "minimumReleaseAge": "3 days",
      "bumpVersions": [
        {
          "name": "Raise the module catalog version",
          "filePatterns": [
            "CATALOG_VERSION"
          ],
          "matchStrings": [
            "^(?<version>\\d+\\.\\d+\\.\\d+)\\s*$"
          ],
          "bumpType": "patch"
        }
      ]
    },
    {
      "matchDepNames": [
        "dock.mau.dev/maubot/maubot"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    {
      "matchDepNames": [
        "dock.mau.dev/maubot/maubot"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    },
    {
      "description": "Major maubot releases always need a manual review",
      "matchDepNames": [
        "dock.mau.dev/maubot/maubot"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "pillow-heif ships in the runtime image: version bump; patch releases merge automatically after CI, minor/major stay manual",
      "matchDepNames": [
        "pillow-heif"
      ],
      "minimumReleaseAge": "7 days",
      "bumpVersions": [
        {
          "name": "Raise the module catalog version",
          "filePatterns": [
            "CATALOG_VERSION"
          ],
          "matchStrings": [
            "^(?<version>\\d+\\.\\d+\\.\\d+)\\s*$"
          ],
          "bumpType": "patch"
        }
      ],
      "commitMessageSuffix": "(auto-merge test)"
    },
    {
      "matchDepNames": [
        "pillow-heif"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    {
      "description": "One Node.js PR for builder image, UI Containerfile and CI; stay on the current major",
      "matchDepNames": [
        "node"
      ],
      "groupName": "Node.js",
      "bumpVersions": [
        {
          "name": "Raise the module catalog version",
          "filePatterns": [
            "CATALOG_VERSION"
          ],
          "matchStrings": [
            "^(?<version>\\d+\\.\\d+\\.\\d+)\\s*$"
          ],
          "bumpType": "patch"
        }
      ]
    },
    {
      "matchDepNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "UI dependencies are part of the module image: one grouped PR, version bump; majors are migrations and stay manual",
      "matchManagers": [
        "npm"
      ],
      "groupName": "UI dependencies",
      "bumpVersions": [
        {
          "name": "Raise the module catalog version",
          "filePatterns": [
            "CATALOG_VERSION"
          ],
          "matchStrings": [
            "^(?<version>\\d+\\.\\d+\\.\\d+)\\s*$"
          ],
          "bumpType": "patch"
        }
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "GitHub Actions do not change the module image",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "matchDepNames": [
        "!node"
      ]
    },
    {
      "description": "Runner images are not updated automatically across majors",
      "matchDepNames": [
        "ubuntu"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
