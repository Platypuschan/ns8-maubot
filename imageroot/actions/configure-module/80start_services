#!/bin/bash

#
# SPDX-License-Identifier: GPL-3.0-or-later
#
set -e

# Redirect any output to the journal (stderr)
exec 1>&2

# enable loads the unit; reset-failed fails on a unit that is not loaded yet.
systemctl --user enable maubot.service
# A previous failed start can have hit the start rate limit; clear it first.
systemctl --user reset-failed maubot.service
# maubot reads its configuration only at start. Restart it only when
# 10configure_maubot changed the configuration (also in an earlier, failed
# run), so saving unchanged settings does not interrupt the bots.
if ! systemctl --user is-active --quiet maubot.service; then
    systemctl --user start maubot.service
elif [[ -e maubot-restart-needed ]]; then
    systemctl --user restart maubot.service
fi
rm -f maubot-restart-needed
