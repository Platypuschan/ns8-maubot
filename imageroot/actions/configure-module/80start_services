#!/bin/bash

#
# SPDX-License-Identifier: GPL-3.0-or-later
#
set -e

# Redirect any output to the journal (stderr)
exec 1>&2

# enable loads the unit; reset-failed fails on a unit that is not loaded yet.
systemctl --user enable maubot.service
# A previous failed start can have hit the start rate limit; clear it first.
systemctl --user reset-failed maubot.service
# maubot reads its configuration only at start, so apply changes with a restart.
systemctl --user restart maubot.service
