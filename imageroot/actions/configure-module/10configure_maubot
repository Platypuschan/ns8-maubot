# Store the maubot settings and render the maubot configuration.

import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import maubot_setup

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)

with maubot_setup.settings_lock():
    try:
        settings = maubot_setup.apply_request(data)
    except maubot_setup.SettingsError as error:
        agent.set_status("validation-failed")
        json.dump([{
            "field": error.field,
            "parameter": error.field,
            "value": error.value,
            "error": error.error,
        }], fp=sys.stdout)
        sys.exit(2)
    maubot_setup.write_config(settings, data["host"])
