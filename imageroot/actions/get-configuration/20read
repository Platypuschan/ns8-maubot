import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import maubot_setup

json.dump(maubot_setup.configuration(
    maubot_setup.read_settings(),
    os.getenv("TRAEFIK_HOST", ""),
    os.getenv("TRAEFIK_HTTP2HTTPS") == "True",
    os.getenv("TRAEFIK_LETS_ENCRYPT") == "True",
), fp=sys.stdout)
